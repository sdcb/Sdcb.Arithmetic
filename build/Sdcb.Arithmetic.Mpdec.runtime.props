<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<SdcbArithmeticMpdecDlls>$(MSBuildThisFileDirectory)..\..\runtimes</SdcbArithmeticMpdecDlls>
	</PropertyGroup>
	<!-- .NET Framework does not understand runtimes/{rid}/native, copy the native libraries to the output folder. -->
	<ItemGroup Condition="$(TargetFrameworkVersion.StartsWith('v4')) Or $(TargetFramework.StartsWith('net4'))">
		<Content Include="$(SdcbArithmeticMpdecDlls)\win-x64\native\*.dll">
			<Link>dll\x64\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
