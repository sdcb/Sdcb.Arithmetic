<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <!-- Native runtime package: defaults to the current OS (x64); override with -p:MpdecRid=... -->
    <MpdecRid Condition="'$(MpdecRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MpdecRid>
    <MpdecRid Condition="'$(MpdecRid)' == ''">linux-x64</MpdecRid>
    <MpdecRuntimeVersion Condition="'$(MpdecRuntimeVersion)' == ''">4.0.1</MpdecRuntimeVersion>
    <!-- Allows testing runtime packages that are not published yet (CI downloads them to build/nupkgs). -->
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\nupkgs')">$(MSBuildThisFileDirectory)..\..\build\nupkgs</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Sdcb.Arithmetic.Mpdec.runtime.$(MpdecRid)" Version="$(MpdecRuntimeVersion)" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdcb.Arithmetic.Mpdec\Sdcb.Arithmetic.Mpdec.csproj" />
  </ItemGroup>

</Project>
